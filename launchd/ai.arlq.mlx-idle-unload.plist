<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.arlq.mlx-idle-unload</string>

	<!-- Periodic check; releases mlx-lm's resident model after an idle period.
	     Not KeepAlive: this is a short-lived script, not a daemon. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/.local/share/claude-local-router/mlx-idle-unload.sh</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
		<!-- Idle threshold before the model is released. -->
		<key>MLX_IDLE_SECONDS</key>
		<string>900</string>
	</dict>

	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<false/>

	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/mlx-idle-unload.err.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/mlx-idle-unload.err.log</string>
</dict>
</plist>
